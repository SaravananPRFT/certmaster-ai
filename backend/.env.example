# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_KEY=your-admin-key
AZURE_SEARCH_INDEX=certmaster-docs
AZURE_SEARCH_SEMANTIC_CONFIG=certmaster-semantic

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-openai.openai.azure.com
AZURE_OPENAI_KEY=your-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Anthropic (Fallback LLM)
ANTHROPIC_API_KEY=sk-ant-...

# Azure Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;...
AZURE_STORAGE_CONTAINER=certmaster-docs

# Redis Cache
REDIS_URL=redis://localhost:6379

# JWT Auth
JWT_SECRET_KEY=change-me-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Azure Entra ID (Optional SSO)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id

# Quality Thresholds
MIN_GROUNDING_SCORE=0.75
MIN_CITATION_COVERAGE=0.60
MAX_SIMILARITY_FOR_DUPLICATE=0.92
TOP_K_RETRIEVAL=5
MAX_CONTEXT_TOKENS=4096

# CORS
ALLOWED_ORIGINS=["http://localhost:3000"]
