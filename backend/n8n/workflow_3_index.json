{
  "name": "CertMasterAI — 3. ChromaDB Indexing",
  "nodes": [
    {
      "parameters": {},
      "id": "node-manual-3",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "jsCode": "// Configure indexing parameters\nreturn [{\n  json: {\n    exam_code: 'all',\n    scraped_dir: './data/scraped',\n    clear_first: false\n  }\n}];"
      },
      "id": "node-code-3a",
      "name": "Configure Index Job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300],
      "notes": "Change exam_code to a specific exam like 'AI-102', or keep 'all' to index everything.\nSet clear_first: true to rebuild from scratch."
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8003/api/v1/admin/index-documents",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"exam_code\": \"{{ $json.exam_code }}\",\n  \"scraped_dir\": \"{{ $json.scraped_dir }}\",\n  \"clear_first\": {{ $json.clear_first }}\n}",
        "options": {
          "timeout": 600000
        }
      },
      "id": "node-http-3",
      "name": "POST /admin/index-documents",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [710, 300],
      "notes": "Calls the FastAPI backend to chunk, embed, and store all scraped docs into ChromaDB."
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst results = data.results || {};\nconst summary = Object.entries(results).map(([exam, r]) => ({\n  exam,\n  status: r.status,\n  chunks: r.chunks_indexed || 0,\n  files: r.files || 0,\n  note: r.reason || ''\n}));\nconst total = summary.reduce((s, r) => s + r.chunks, 0);\nconsole.log(`Total chunks indexed: ${total}`);\nconsole.log(JSON.stringify(summary, null, 2));\nreturn [{ json: { summary, total_chunks: total } }];"
      },
      "id": "node-code-3b",
      "name": "Summarise Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [940, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-chunks",
              "leftValue": "={{ $json.total_chunks }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "node-if-3",
      "name": "Index Has Content?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1170, 300]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nreturn [{ json: { status: 'SUCCESS', message: `ChromaDB ready — ${data.total_chunks} chunks indexed`, summary: data.summary } }];"
      },
      "id": "node-success-3",
      "name": "Success",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1400, 220]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { status: 'WARNING', message: 'ChromaDB is empty — run download_docs.py first, then re-trigger this workflow' } }];"
      },
      "id": "node-warn-3",
      "name": "Warn Empty",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1400, 400]
    },
    {
      "parameters": {
        "content": "## Workflow 3 — ChromaDB Indexing\n\nIndexes scraped docs from disk into ChromaDB via the backend API.\n\n**Input:** Scraped .txt + .meta.json files in `data/scraped/<exam>/`\n**Output:** Chunks embedded and stored in ChromaDB\n\n**Parameters (edit in 'Configure Index Job' node):**\n- `exam_code`: `\"all\"` or specific like `\"AI-102\"`\n- `scraped_dir`: path relative to backend working directory\n- `clear_first`: `true` to wipe + rebuild, `false` to upsert",
        "height": 210,
        "width": 380
      },
      "id": "node-note-3",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [250, 520]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Configure Index Job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Configure Index Job": {
      "main": [
        [
          {
            "node": "POST /admin/index-documents",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "POST /admin/index-documents": {
      "main": [
        [
          {
            "node": "Summarise Results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Summarise Results": {
      "main": [
        [
          {
            "node": "Index Has Content?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Index Has Content?": {
      "main": [
        [
          {
            "node": "Success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Warn Empty",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "id": "certmasterai-wf-003",
  "tags": [
    {"id": "certmasterai", "name": "certmasterai"}
  ]
}
